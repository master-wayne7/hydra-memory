# LLM_PROVIDER selects the backend llm_client.py uses. Default setup: "ollama" (local, no API
# key, no rate limit -- requires `ollama pull qwen2.5:3b-instruct` and `qwen2.5:7b-instruct`,
# and the Ollama server running on 127.0.0.1:11434).
# Other supported values -- "groq", "gemini", "cerebras" -- each need their own API key
# (GROQ_API_KEY / GEMINI_API_KEY / CEREBRAS_API_KEY) added below if used.
LLM_PROVIDER=ollama

HYDRA_AUTH_TOKEN=local-development-token-32-bytes
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_NAMESPACE=default
HYDRA_GRAPH=default
HYDRA_CELL_ID=cell-0
